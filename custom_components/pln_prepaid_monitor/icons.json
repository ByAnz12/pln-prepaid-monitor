{
  "entity": {
    "binary_sensor": {
      "data_sufficient": {
        "default": "mdi:database-alert",
        "state": {
          "on": "mdi:database-check"
        }
      },
      "rate_change_pending": {
        "default": "mdi:cash-check",
        "state": {
          "on": "mdi:cash-sync"
        }
      }
    },
    "button": {
      "record_topup": {
        "default": "mdi:cash-plus"
      },
      "calibrate_token": {
        "default": "mdi:auto-fix"
      },
      "save_template": {
        "default": "mdi:content-save-plus"
      }
    },
    "number": {
      "critical_threshold_days": {
        "default": "mdi:alert-circle"
      },
      "meter_reading_kwh": {
        "default": "mdi:meter-electric-outline"
      },
      "rate_rp_per_kwh": {
        "default": "mdi:cash"
      },
      "topup_kwh": {
        "default": "mdi:cash-plus"
      },
      "topup_rp": {
        "default": "mdi:cash"
      },
      "very_critical_threshold_days": {
        "default": "mdi:alert-octagon"
      },
      "warning_threshold_days": {
        "default": "mdi:alert-circle-outline"
      }
    },
    "sensor": {
      "energy": {
        "default": "mdi:meter-electric-outline"
      },
      "energy_total": {
        "default": "mdi:counter"
      },
      "cost_total": {
        "default": "mdi:cash-multiple"
      },
      "token_remaining": {
        "default": "mdi:gauge"
      },
      "token_consumed": {
        "default": "mdi:lightning-bolt"
      },
      "avg_daily_usage": {
        "default": "mdi:chart-line"
      },
      "days_remaining": {
        "default": "mdi:calendar-clock"
      },
      "empty_date": {
        "default": "mdi:calendar-alert"
      },
      "token_status": {
        "default": "mdi:help-circle-outline",
        "state": {
          "normal": "mdi:check-circle",
          "warning": "mdi:alert-circle-outline",
          "critical": "mdi:alert-circle",
          "very_critical": "mdi:alert-octagon",
          "hold": "mdi:pause-circle",
          "unknown": "mdi:help-circle-outline"
        }
      }
    }
  },
  "services": {
    "add_token_topup": "mdi:cash-plus",
    "calibrate_token_reading": "mdi:auto-fix",
    "edit_topup": "mdi:pencil",
    "delete_topup": "mdi:delete-outline",
    "reset_token_ledger": "mdi:restore-alert",
    "resolve_ledger_hold": "mdi:play-circle-outline",
    "generate_dashboard": "mdi:view-dashboard-outline",
    "purge_old_data": "mdi:database-remove",
    "resolve_rate_change": "mdi:cash-sync",
    "save_topup_template": "mdi:content-save-plus"
  }
